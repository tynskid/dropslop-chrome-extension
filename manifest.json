{
  "manifest_version": 3,
  "name": "DropSlop: check selected text",
  "version": "0.1.0",
  "description": "Select text on any page and see which phrases read as machine-made, with a suggested replacement for each.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "host_permissions": ["https://dropslop.ai/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Check selection with DropSlop",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
